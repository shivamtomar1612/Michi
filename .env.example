# Public Supabase project configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Modern Supabase publishable key is also accepted by the client helpers.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase privileged access. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Current Supabase secret API key is accepted as an alternative server credential.
SUPABASE_SECRET_KEY=

# Vercel Cron authorization for in-app cultural preparation reminders
CRON_SECRET=

# Server-side Gemini configuration
GEMINI_API_KEY=
# Use a Gemini API model ID. The generic alias "Gemini" maps to the app default.
AI_MODEL=gemini-3.8-flash

# Optional semantic retrieval; keyword retrieval works when these are blank.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

# Optional server-only HMAC salt for public cultural evidence rate-limit keys.
RATE_LIMIT_SALT=

# Browser-visible Google Maps key; restrict it to approved browser origins/APIs.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=

# Canonical application origin
NEXT_PUBLIC_APP_URL=
